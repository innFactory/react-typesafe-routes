{
  "name": "react-typesafe-routes",
  "version": "0.0.8",
  "description": "The last routing library you will ever need in your react projects - Completely typesafe and easy to use.",
  "keywords": [
    "typesafe-routing",
    "routing",
    "route-options",
    "route-middleware",
    "react-router",
    "react",
    "react-router-dom"
  ],
  "license": "MIT",
  "author": "Nicolas Schlecker (hi@nicolasschlecker.de)",
  "main": "dist/index.umd.js",
  "types": "src/index.ts",
  "files": [
    "dist",
    "src",
    "tsconfig.json",
    "vite.config.js"
  ],
  "scripts": {
    "analyze": "size-limit --why",
    "build": "tsdx build",
    "react": "yarn run build && yarn parcel src/react/index.html",
    "doc:build": "typedoc src/index.ts",
    "doc:deploy": "yarn doc:build && gh-pages -d docs",
    "size": "size-limit",
    "postinstall": "npm run build"
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.1.6",
    "@types/qs": "^6.9.17",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "gh-pages": "^6.2.0",
    "parcel": "^2.13.2",
    "qs": "^6.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.0.1",
    "size-limit": "^11.1.6",
    "tslib": "^2.8.1",
    "tsdx": "^0.14.1",
    "typedoc": "^0.26.11",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "react-router-dom": ">=6.14.1",
    "typescript": ">=5.2.2"
  },
  "overrides": {
    "@parcel/watcher": "2.1.0"
  },
  "size-limit": [
    {
      "path": "dist/react-typesafe-routes.cjs.production.min.js",
      "limit": "10 KB"
    },
    {
      "path": "dist/react-typesafe-routes.esm.js",
      "limit": "10 KB"
    }
  ]
}
